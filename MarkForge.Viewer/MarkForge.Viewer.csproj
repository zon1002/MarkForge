<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Mv.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dark/light chrome theming, shared with the Editor. -->
    <Compile Include="..\MarkForge.Editor\UiTheme.cs" Link="UiTheme.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MarkForge.Core\MarkForge.Core.csproj" />
  </ItemGroup>

</Project>